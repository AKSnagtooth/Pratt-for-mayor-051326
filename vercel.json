{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/track.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/lead.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/send-reminders.js": {
      "memory": 512,
      "maxDuration": 300
    },
    "api/sms-webhook.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/unsubscribe.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/send-welcome.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "0 17 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
